{
  "name": "quickip",
  "version": "7.1.3",
  "description": "A browser extension to quickly find your IPv4 and IPv6 addresses",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "check-formatting": "oxfmt --check",
    "check-types": "tsc --noEmit --skipLibCheck && tsc --noEmit --skipLibCheck --project build/tsconfig.json && tsc --noEmit --skipLibCheck --project tests/tsconfig.json",
    "format": "oxfmt",
    "build": "tsx build/build.ts",
    "build-debug": "tsx build/build.ts --debug",
    "pkg": "tsx build/pkg.ts",
    "clean": "tsx build/clean.ts",
    "release": "npm run check-types && npm run check-formatting && npm run lint && npm run clean && npm run build && npm run pkg",
    "test": "vitest"
  },
  "repository": "github:mdmower/quickip",
  "keywords": [
    "ip",
    "ipv4",
    "ipv6",
    "quickip",
    "addon",
    "extension"
  ],
  "author": "Matthew D. Mower <mdmower@cmphys.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mdmower/quickip/issues"
  },
  "homepage": "https://github.com/mdmower/quickip#readme",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "puppeteer": true
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "is-ip": "^5.0.1",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^9.1.0",
    "@types/archiver": "^8.0.0",
    "@types/bootstrap": "^5.2.11",
    "@types/chrome": "0.3.8",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "archiver": "^8.0.0",
    "deepmerge": "^4.3.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "puppeteer": "^25.18.1",
    "sass-embedded": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
